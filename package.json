{
  "name": "@videogen/openclaw-plugin",
  "version": "2.1.13",
  "description": "OpenClaw plugin for VideoGen. Exposes the full VideoGen API (workflows, media generation, projects, files) as native OpenClaw tools.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "index.ts",
    "src/**/*.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:@videogen/openclaw-plugin",
      "npmSpec": "@videogen/openclaw-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.6.8"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint index.ts src",
    "lint:fix": "eslint index.ts src --fix",
    "test": "node --import ./test/register.mjs --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@videogen/sdk": "^2.1.13",
    "typebox": "1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.19.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.14.0",
    "openclaw": "2026.7.1-2",
    "tsup": "^8.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.13.0"
  }
}
